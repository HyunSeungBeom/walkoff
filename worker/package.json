{
  "name": "walkoff-api",
  "private": true,
  "type": "module",
  "description": "walkoff 주간 랭킹 서버(Cloudflare Workers + D1)",
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute walkoff --local --file=schema.sql",
    "db:remote": "wrangler d1 execute walkoff --remote --file=schema.sql",
    "stats": "node scripts/stats.mjs"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  }
}
